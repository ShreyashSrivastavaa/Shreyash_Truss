{
  "name": "nexus-workspace",
  "version": "0.1.0",
  "description": "Multi-Depot Inventory Balancing Prototype inspired by Nexus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,cyan\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/src/index.js",
    "test": "npm --prefix server test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.19.3"
  }
}
