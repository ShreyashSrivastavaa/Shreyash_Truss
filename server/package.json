{
  "name": "nexus-server",
  "version": "0.1.0",
  "description": "Backend API service for Nexus supply chain prototype",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
